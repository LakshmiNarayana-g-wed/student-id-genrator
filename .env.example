# Backend Server Configuration
PORT=5000

# MongoDB Connection String (Replace with your MongoDB Atlas or local MongoDB URI)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/student_id_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/student_id_db

# Frontend API Base URL
VITE_API_URL=http://localhost:5000
